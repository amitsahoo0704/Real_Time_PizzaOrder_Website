<!-- Carousel -->
<section class="container mx-auto py-12">
    <div class="carousel" id="galleryCarousel">
        <div class="carousel-track">
            <div class="carousel-slide"><img src="/img/piz1.jpg" loading="lazy" alt="gallery1"></div>
            <div class="carousel-slide"><img src="/img/hero-pizza.png" loading="lazy" alt="gallery2"></div>
            <div class="carousel-slide"><img src="/img/pizza.png" loading="lazy" alt="gallery3"></div>
        </div>
        <div class="carousel-dots" role="tablist" aria-label="Gallery navigation"></div>
        <div class="carousel-controls">
            <button class="carousel-btn" id="prevBtn" aria-label="Previous slide">‹</button>
            <button class="carousel-btn" id="nextBtn" aria-label="Next slide">›</button>
        </div>
        <div id="carouselAnnouncer" class="sr-only" aria-live="polite"></div>
    </div>
</section>

