        <div class="testimonial">"Fast delivery and hot pizza. Highly recommend." — Karan</div>
        <div class="testimonial">"Great flavours and friendly service." — Priya</div>
    </div>
</section>

<script>
// Simple carousel script
;(function(){
    const carousel = document.getElementById('galleryCarousel')
    const track = carousel.querySelector('.carousel-track')
    const slides = Array.from(track.children)
    const prev = document.getElementById('prevBtn')
    const next = document.getElementById('nextBtn')
    const dotsContainer = carousel.querySelector('.carousel-dots')
    let index = 0

    // build dots
    slides.forEach((s, i) => {
        const btn = document.createElement('button')
        btn.className = 'carousel-dot'
        btn.setAttribute('role', 'tab')
        btn.setAttribute('aria-selected', i === 0 ? 'true' : 'false')
        btn.setAttribute('aria-controls', `slide-${i}`)
        btn.setAttribute('data-index', i)
        btn.addEventListener('click', () => { goTo(i); btn.focus() })
        dotsContainer.appendChild(btn)
        // mark slides with ids for aria
        s.setAttribute('id', `slide-${i}`)
        s.setAttribute('role', 'tabpanel')
        s.setAttribute('aria-hidden', i === 0 ? 'false' : 'true')
    })

    function update() {
        track.style.transform = `translateX(-${index * 100}%)`
        // update dots and aria
        const dots = dotsContainer.querySelectorAll('.carousel-dot')
        dots.forEach((d, i) => {
            d.setAttribute('aria-selected', i === index ? 'true' : 'false')
            const slide = document.getElementById(`slide-${i}`)
            if (slide) slide.setAttribute('aria-hidden', i === index ? 'false' : 'true')
        })
        // announce slide change for screen readers
        const announcer = document.getElementById('carouselAnnouncer')
        if (announcer) {
            const activeImg = slides[index].querySelector('img')
            const label = activeImg ? activeImg.getAttribute('alt') || `Slide ${index+1}` : `Slide ${index+1}`
            announcer.innerText = `Slide ${index+1} of ${slides.length}: ${label}`
        }
    }

    function goTo(i) { index = (i + slides.length) % slides.length; update() }

    prev && prev.addEventListener('click', () => { goTo(index - 1) })
    next && next.addEventListener('click', () => { goTo(index + 1) })

    // keyboard navigation
    carousel.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') { e.preventDefault(); goTo(index - 1) }
        if (e.key === 'ArrowRight') { e.preventDefault(); goTo(index + 1) }
        if (e.key === 'Home') { e.preventDefault(); goTo(0) }
        if (e.key === 'End') { e.preventDefault(); goTo(slides.length - 1) }
    })

    // auto-advance but pause on focus
    let auto = setInterval(() => { goTo(index + 1) }, 5000)
    carousel.addEventListener('focusin', () => clearInterval(auto))
    carousel.addEventListener('focusout', () => { auto = setInterval(() => { goTo(index + 1) }, 5000) })

    // make carousel focusable
    carousel.setAttribute('tabindex', '0')
    update()
})()
</script>
<script>
// Promo banner dismiss and smooth scroll
;(function(){
    const banner = document.getElementById('promoBanner')
    const close = document.getElementById('closePromo')
    try {
        if (localStorage && localStorage.getItem('promoClosed')) {
            banner && (banner.style.display = 'none')
        }
    } catch(e){}
    if (close) close.addEventListener('click', function(){
        banner && (banner.style.display = 'none')
        try{ localStorage && localStorage.setItem('promoClosed','1') }catch(e){}
    })
    // smooth scroll for any promo CTA anchor
    document.querySelectorAll('.promo-banner a, .promo-card a').forEach(a=>{
        a.addEventListener('click', function(e){
            const href = this.getAttribute('href')
            if (href && href.startsWith('#')){
                e.preventDefault()
                const el = document.querySelector(href)
                if (el) el.scrollIntoView({behavior:'smooth', block:'start'})
            }
        })
    })
})()
</script>
<section class="menu container mx-auto py-8">
    <h1 class="text-xl font-bold mb-8">All Pizzas</h1>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 col-gap-12 row-gap-16">
        <% pizzas.forEach(function(pizza) { %>
        <div class="w-full md:w-64">
            <% 
                const localImages = ['piz1.jpg','pizza.png','hero-pizza.png'];
                function nameHash(s){ let h=0; for(let i=0;i<s.length;i++){ h = ((h<<5)-h) + s.charCodeAt(i); h |= 0 } return Math.abs(h) }
                const imgFile = localImages[nameHash(pizza.name) % localImages.length];
            %>
            <img class="h-40 mb-4 mx-auto" src="/img/<%= imgFile %>" alt="<%= pizza.name %>">
            <div class="text-center">
                <h2 class="mb-4 text-lg"><%= pizza.name %></h2>
                <span class="size py-1 px-4 rounded-full uppercase text-xs"><%= pizza.size %></span>
                <div class="flex items-center justify-around mt-6">
                    <span class="font-bold text-lg">₹<%= pizza.price %></span>
                    <button data-pizza="<%= JSON.stringify(pizza) %>"
                        class="add-to-cart py-1 px-6 rounded-full flex items-center font-bold">
                        <span>+</span>
                        <span class="ml-4">Add</span>
                        <span class="add-count ml-2"><%= session.cart && session.cart.items && session.cart.items[pizza._id] ? '+' + session.cart.items[pizza._id].qty : '' %></span>
                    </button>
                </div>
            </div>
        </div>
        <% }) %>

    </div>
</section>